# PPE YOLO with GPU preprocess: raw BGR frame -> DALI letterbox (GPU) -> TRT YOLO.
# The worker sends the raw uint8 BGR frame and gets the same [1,300,6] boxes, but the
# letterbox runs on the GPU instead of cv2 on the CPU.
name: "ppe_yolo_ensemble"
platform: "ensemble"
max_batch_size: 0
input [
  { name: "RAW_IMAGE" data_type: TYPE_UINT8 dims: [ 1, -1, -1, 3 ] }
]
output [
  { name: "output0" data_type: TYPE_FP32 dims: [ 1, 300, 6 ] }
]
ensemble_scheduling {
  step [
    {
      model_name: "ppe_yolo_pp"
      model_version: -1
      input_map { key: "DALI_INPUT_0" value: "RAW_IMAGE" }
      output_map { key: "DALI_OUTPUT_0" value: "preprocessed" }
    },
    {
      model_name: "ppe_yolo26_trt"
      model_version: -1
      input_map { key: "images" value: "preprocessed" }
      output_map { key: "output0" value: "output0" }
    }
  ]
}
