# GPU letterbox preprocess for the PPE YOLO detector (DALI backend).
# Input: raw BGR uint8 HWC frame (variable H,W). Output: [1,3,1280,1280] FP32,
# aspect-preserving resize (long side=1280) + grey(114) TOP-LEFT pad + RGB + /255.
# Top-left pad (pad_x=pad_y=0) so the worker inverts boxes with a single scale and
# zero pad. Replaces the per-frame cv2 letterbox on the CPU.
name: "ppe_yolo_pp"
backend: "dali"
max_batch_size: 0
input [
  { name: "DALI_INPUT_0" data_type: TYPE_UINT8 dims: [ 1, -1, -1, 3 ] }
]
output [
  { name: "DALI_OUTPUT_0" data_type: TYPE_FP32 dims: [ 1, 3, 1280, 1280 ] }
]
parameters [ { key: "num_threads" value: { string_value: "2" } } ]
instance_group [ { count: 1 kind: KIND_GPU } ]
